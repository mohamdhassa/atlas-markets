# Copy to a protected file outside the repository, for example:
# /home/ubuntu/.config/atlas/ibkr-ibc.env (chmod 600)

TWS_USERID=REPLACE_WITH_IBKR_PAPER_USERNAME
IBKR_SECRET_DIR=/home/ubuntu/.config/atlas/ibkr-ibc-secrets

# Staging ports deliberately do not replace the current Gateway.
IBKR_PAPER_HOST_PORT=14002
IBKR_VNC_HOST_PORT=15902

TRADING_MODE=paper
READ_ONLY_API=yes
TWS_ACCEPT_INCOMING=yes
AUTO_RESTART_TIME=11:45 PM
TIME_ZONE=Etc/UTC
