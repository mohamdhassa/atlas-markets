# Copy outside the repository; chmod 600. Fill with this owner's values.
IBKR_INSTANCE=owner-example
TWS_USERID=REPLACE_WITH_PAPER_USERNAME
IBKR_ACCOUNT_ID=REPLACE_WITH_PAPER_ACCOUNT_ID
IBKR_SECRET_DIR=/home/ubuntu/.config/atlas/ibkr-owner-example/secrets
IBKR_BRIDGE_SOURCE=/home/ubuntu/.config/atlas/ibkr-owner-example/ibkr_bridge.py
IBKR_VNC_HOST_PORT=15912
IBKR_BRIDGE_HOST_PORT=18766
ATLAS_APP_IMAGE=REPLACE_WITH_VALIDATED_SHA256_IMAGE_ID
ATLAS_APP_NETWORK=REPLACE_WITH_APP_NETWORK
READ_ONLY_API=yes
