APP_NAME=ATLAS MARKETS
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://atlas:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/atlas_markets
REDIS_URL=redis://redis:6379/0
TEST_DATABASE_URL=postgresql+psycopg://atlas:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/atlas_markets
TEST_REDIS_URL=redis://redis:6379/0
ATLAS_MARKETS_MASTER_KEY=REPLACE_WITH_GENERATED_SECRET
SESSION_SECRET=REPLACE_WITH_GENERATED_SECRET
SESSION_TTL_HOURS=24
ALLOW_LIVE_TRADING=false
BYBIT_PUBLIC_BASE_URL=https://api.bybit.com
BYBIT_DEMO_BASE_URL=https://api-demo.bybit.com
BYBIT_TESTNET_BASE_URL=https://api-testnet.bybit.com
FX_MARKET_DATA_BASE_URL=https://api.twelvedata.com
FX_MARKET_DATA_API_KEY=
MARKET_DATA_TIMEOUT_SECONDS=15

# Broker bridge URLs are stored encrypted per BrokerProfile in the application.
# For Oracle production, point MT5/IBKR profiles to private VPN addresses of the
# execution nodes, never to public bridge ports.
